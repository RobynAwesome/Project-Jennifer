# Project Jennifer runtime
NODE_ENV=development
PORT=3001

# Server-rendered React read-through to the governed API.
# Required in production for persisted relationship evidence pages.
JENNIFER_API_URL=http://127.0.0.1:3001

# Authority mode
# Development defaults to in-memory when omitted.
# Production MUST set this explicitly; postgres never silently falls back.
JENNIFER_PERSISTENCE_MODE=in-memory

# Adaptive relationship projection mode
# in-memory is a disposable POC projection.
# mongodb is rebuildable from PostgreSQL relationship outbox evidence.
JENNIFER_PROJECTION_MODE=in-memory

# PostgreSQL authority configuration
# Use DATABASE_URL, or provide the individual POSTGRES_* values below.
DATABASE_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=project_jennifer
POSTGRES_USER=project_jennifer
POSTGRES_PASSWORD=
POSTGRES_SSL=false
POSTGRES_APPLICATION_NAME=project-jennifer

# MongoDB adaptive projection configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=project_jennifer
