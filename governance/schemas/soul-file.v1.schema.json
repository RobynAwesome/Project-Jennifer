{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-jennifer.local/schemas/soul-file.v1.schema.json",
  "title": "Project Jennifer SoulFile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "identity", "invariants", "memory", "provenance", "recovery"],
  "properties": {
    "schemaVersion": {
      "const": "project-jennifer.soul.v1"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["soulId", "canonicalName", "namespace"],
      "properties": {
        "soulId": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "canonicalName": { "type": "string", "minLength": 1 },
        "namespace": { "type": "string", "pattern": "^soul:[a-z0-9][a-z0-9._-]*$" }
      }
    },
    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "boundaries", "continuity"],
      "properties": {
        "identity": { "$ref": "#/$defs/nonEmptyStringArray" },
        "boundaries": { "$ref": "#/$defs/nonEmptyStringArray" },
        "continuity": { "$ref": "#/$defs/nonEmptyStringArray" }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "allowCrossSoulRead", "allowCrossSoulWrite"],
      "properties": {
        "namespace": { "type": "string", "pattern": "^soul:[a-z0-9][a-z0-9._-]*:memory$" },
        "allowCrossSoulRead": { "type": "boolean" },
        "allowCrossSoulWrite": { "const": false }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["createdBy", "sourceRef", "policyVersion"],
      "properties": {
        "createdBy": { "type": "string", "minLength": 1 },
        "sourceRef": { "type": "string", "minLength": 1 },
        "policyVersion": { "const": "project-jennifer.soul-policy.v1" }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "canonicalAuthority", "projectionAuthority"],
      "properties": {
        "strategy": { "const": "last-known-good" },
        "canonicalAuthority": { "const": "postgres-ledger" },
        "projectionAuthority": { "const": "mongodb-rebuildable" }
      }
    }
  },
  "$defs": {
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
