# Jennifer API — server env (safe to commit as example)
# Copy to apps/api/.env for local overrides. Never commit real secrets.

PORT=3001
NODE_ENV=development

# Comma-separated browser origins allowed to call the API.
# Production MUST set this explicitly (localhost defaults are disabled when NODE_ENV=production).
# Example production:
# JENNIFER_CORS_ORIGINS=https://jennifer-city.example.com,https://jennifer-city.vercel.app
JENNIFER_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Origin honesty (not identity zero-trust by itself):
# - Production rejects missing Origin by default (curl without Origin fails).
# - Dev allows missing Origin so local tooling can probe.
# - Set REQUIRE_ORIGIN=1 to force the rule in development.
# - Set ALLOW_MISSING_ORIGIN=1 only for ops probes that cannot send Origin.
# JENNIFER_CORS_REQUIRE_ORIGIN=1
# JENNIFER_CORS_ALLOW_MISSING_ORIGIN=1

# Optional persistence (relationship authority). Leave unset for in-memory POC.
# DATABASE_URL=
# MONGODB_URI=
