{
  "name": "@jennifer/memory",
  "version": "0.1.0",
  "private": true,
  "description": "GSMB – Grounded State Memory Buffer: persistent memory, consistency, context, indexing",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --project tsconfig.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --filter @jennifer/telemetry build && pnpm run build && node --test dist/**/*.test.js",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "postinstall": "pnpm run prisma:generate",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@jennifer/shared": "workspace:*",
    "@prisma/client": "^6.12.0"
  },
  "devDependencies": {
    "@jennifer/telemetry": "workspace:*",
    "prisma": "^6.12.0",
    "typescript": "^5.5.0"
  }
}
