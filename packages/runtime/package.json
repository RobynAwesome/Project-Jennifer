{
  "name": "@jennifer/runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Jennifer Runtime – persona management, world state, district orchestration",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --project tsconfig.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && node --test $(find dist -type f -name '*.test.js')",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@jennifer/shared": "workspace:*",
    "@jennifer/governance": "workspace:*",
    "@jennifer/telemetry": "workspace:*",
    "@jennifer/memory": "workspace:*",
    "@jennifer/validation": "workspace:*",
    "@jennifer/hue": "workspace:*",
    "@jennifer/collective-ingress": "workspace:*",
    "@jennifer/crisis-connect": "workspace:*",
    "@jennifer/npc": "workspace:*"
  },
  "devDependencies": {
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "@typescript/native": "npm:typescript@^7.0.2"
  }
}
